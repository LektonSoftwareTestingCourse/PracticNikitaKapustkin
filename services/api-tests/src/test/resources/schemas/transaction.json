{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transaction (docs/api/openapi.yaml)",
  "type": "object",
  "required": ["id", "mti", "stan", "rrn", "pan", "processingCode", "amount", "currencyCode", "terminalId",
    "terminalType", "merchantId", "mcc", "acquirerId", "issuerId", "acquiringFee", "status", "declineReason",
    "authCode", "processingTimeMs", "transmissionDateTime", "createdAt"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "mti": {"type": "string"},
    "stan": {"type": "string"},
    "rrn": {"type": ["string", "null"]},
    "pan": {"type": "string", "pattern": "^\\d{16}$"},
    "processingCode": {"type": "string"},
    "amount": {"type": "number"},
    "currencyCode": {"type": "string"},
    "terminalId": {"type": "string", "maxLength": 8},
    "terminalType": {"type": ["string", "null"]},
    "merchantId": {"type": "string", "maxLength": 15},
    "mcc": {"type": "string"},
    "acquirerId": {"type": "string"},
    "issuerId": {"type": ["string", "null"]},
    "acquiringFee": {"type": ["number", "null"]},
    "status": {"enum": ["APPROVED", "DECLINED"]},
    "declineReason": {"type": ["string", "null"]},
    "authCode": {"type": ["string", "null"]},
    "processingTimeMs": {"type": ["integer", "null"]},
    "transmissionDateTime": {"type": "string", "format": "date-time"},
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
