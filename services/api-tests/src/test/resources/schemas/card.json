{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Card (docs/api/openapi.yaml); expiryDate по факту YYYY-MM, см. D-03",
  "type": "object",
  "required": ["id", "pan", "bin", "cardholderName", "expiryDate", "status", "currencyCode",
    "dailyLimit", "monthlyLimit", "availableBalance", "issuerId", "createdAt"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "pan": {"type": "string", "pattern": "^\\d{16}$"},
    "bin": {"type": "string", "pattern": "^\\d{6}$"},
    "cardholderName": {"type": "string"},
    "expiryDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}$"},
    "status": {"enum": ["ACTIVE", "INACTIVE", "BLOCKED", "EXPIRED"]},
    "currencyCode": {"type": "string", "pattern": "^\\d{3}$"},
    "dailyLimit": {"type": "integer"},
    "monthlyLimit": {"type": "integer"},
    "availableBalance": {"type": "integer"},
    "issuerId": {"type": "string"},
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
